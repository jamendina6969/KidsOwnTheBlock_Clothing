<main class="bg-white pt-10 pb-16">
  <div class="max-w-[1600px] mx-auto px-3 md:px-6">
    <div class="grid grid-cols-1 lg:grid-cols-[1.1fr_0.9fr] gap-10 lg:gap-12 items-start">
      <div class="anim-fade-up">
        <div
          id="lb-stage-wrap"
          class="aspect-[3/4] w-full max-w-[560px] overflow-hidden bg-black relative"
          data-lookbook-slides='[
            {"look":1,"title":"HOODLUMS NO EVIL // STAIRWELL DUO","garments":"400 GSM Boxy Oversized Tee & Snow-Washed Tee","img":"{{ 'campaign-duo-tees.jpg' | asset_url }}"},
            {"look":2,"title":"NO EVIL BOXY OVERSIZED TEE — CONCRETE FLASH","garments":"400 GSM Ultra-Heavyweight Cotton / Drop Shoulder","img":"{{ 'campaign-female.jpg' | asset_url }}"},
            {"look":3,"title":"NO EVIL BOXY TEE — INDUSTRIAL CORRIDOR","garments":"400 GSM Boxy Oversized Tee / Baggy Utility Cargo","img":"{{ 'campaign-male.jpg' | asset_url }}"},
            {"look":4,"title":"NO EVIL CAPSULE — TANK & WASHED TEE","garments":"340 GSM Frayed French Terry Tank & Snow-Washed Tee","img":"{{ 'campaign-duo-tank.jpg' | asset_url }}"}
          ]'
        >
          <img
            id="lb-main-img"
            src="{{ 'campaign-duo-tees.jpg' | asset_url }}"
            alt="HOODLUMS NO EVIL Lookbook"
            class="w-full h-full object-cover object-top block"
          />
          <span id="lb-look-tag" class="font-mono-meta absolute bottom-3 left-3 bg-black/75 text-white px-2.5 py-1 text-[10px] tracking-[0.14em]">LOOK 01</span>
        </div>
        <h1 id="lb-col-title" class="font-display text-[22px] mt-5 mb-1.5">NO EVIL CAPSULE // 2026</h1>
        <div id="lb-look-label" class="text-[13px] font-semibold">Look 1</div>
        <div id="lb-look-caption" class="font-mono-meta text-xs text-[#666] mt-1">
          HOODLUMS NO EVIL // STAIRWELL DUO — 400 GSM Boxy Oversized Tee &amp; Snow-Washed Tee
        </div>
      </div>

      <div class="flex flex-col gap-6 anim-fade-up" style="animation-delay: 120ms;">
        <div id="lb-thumbs" class="grid grid-cols-4 gap-2"></div>

        <div class="font-mono-meta flex items-center justify-between gap-4 text-[13px]">
          <div class="flex items-center gap-4">
            <button id="lb-prev" type="button" aria-label="Previous look" class="cursor-pointer">←</button>
            <span id="lb-counter">1 of 4</span>
            <button id="lb-next" type="button" aria-label="Next look" class="cursor-pointer">→</button>
          </div>
          <a href="/collections/no-evil" data-nav class="btn-sheen font-display bg-black text-white rounded-[30px] px-4 py-2 text-[11px]">
            SHOP THIS LOOK ↗
          </a>
        </div>

        {%- if collections.all.products.size > 0 -%}
          <div class="border-t border-black/10 pt-5">
            <div class="font-mono-meta text-[10px] text-[#666] mb-3">TAGGED GARMENTS IN THIS COLLECTION</div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
              {%- for lp in collections.all.products limit: 4 -%}
                <a href="{{ lp.url }}" data-nav class="border border-black/15 hover:border-black p-2.5 flex items-center gap-2.5 transition-colors bg-[#fafafa]">
                  <div class="w-10 h-12 shrink-0 bg-white overflow-hidden">
                    {%- if lp.featured_image != blank -%}
                      <img src="{{ lp.featured_image | image_url: width: 120 }}" alt="{{ lp.title | escape }}" class="w-full h-full object-contain" />
                    {%- endif -%}
                  </div>
                  <div class="min-w-0">
                    <div class="font-display text-[10px] truncate">{{ lp.title }}</div>
                    <div class="font-mono-meta text-[10px] text-[#666]">{{ lp.price | money }} →</div>
                  </div>
                </a>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</main>

{% schema %}
{
  "name": "KOTB Lookbooks",
  "settings": []
}
{% endschema %}
