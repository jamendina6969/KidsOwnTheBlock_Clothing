<div class="font-mono-meta text-[11px] text-white/60 tracking-[0.12em]">
  {%- if shop.password_message != blank -%}
    <p>{{ shop.password_message }}</p>
  {%- else -%}
    <p>{{ section.settings.subtext }}</p>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "KOTB Password Message",
  "settings": [
    {
      "type": "text",
      "id": "subtext",
      "label": "Default subtext",
      "default": "HOODLUMS · ARCHIVE DROP OPENING SOON"
    }
  ]
}
{% endschema %}
