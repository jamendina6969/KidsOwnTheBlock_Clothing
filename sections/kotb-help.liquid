<main class="bg-white pt-12 pb-16">
  <div class="max-w-[1080px] mx-auto px-3 md:px-6">
    <h1 class="font-display text-[30px] mb-5 anim-fade-up">HOW CAN WE HELP?</h1>

    <div class="relative mb-5">
      <input id="help-search" type="text" placeholder="Search shipping, returns, sizing, COD..." class="w-full h-12 rounded-[8px] border border-black pl-4 pr-11 text-sm outline-none" />
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#000" stroke-width="1.6" class="absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
    </div>

    <div class="flex flex-wrap gap-2 mb-9">
      {%- assign topics = 'ALL,Orders,Shipping,Returns,Sizing' | split: ',' -%}
      {%- for t in topics -%}
        <button type="button" data-help-topic="{{ t }}" class="help-topic-btn rounded-[30px] border border-black px-4 py-1.5 text-xs font-semibold cursor-pointer {% if forloop.first %}bg-black text-white{% else %}bg-white text-black{% endif %}">
          {{ t }}
        </button>
      {%- endfor -%}
    </div>

    <div id="help-faq-grid" class="grid grid-cols-1 md:grid-cols-2 gap-x-9 mb-14">
      <div class="help-faq-item border-y border-black/10 py-4 reveal-on-scroll" data-topic="Orders" data-delay="0">
        <button type="button" class="help-faq-toggle w-full flex justify-between items-center gap-3 text-left text-sm font-semibold cursor-pointer">
          <span>Can I modify or cancel my order after checkout?</span><span>▾</span>
        </button>
        <p class="help-faq-answer text-[13px] leading-relaxed text-[#444] mt-3">Orders can be modified or cancelled within 2 hours of placement before our warehouse begins packing. Submit a support ticket below with your order number.</p>
      </div>

      <div class="help-faq-item border-y border-black/10 py-4 reveal-on-scroll" data-topic="Shipping" data-delay="50">
        <button type="button" class="help-faq-toggle w-full flex justify-between items-center gap-3 text-left text-sm font-semibold cursor-pointer">
          <span>How long does domestic and international shipping take?</span><span>▾</span>
        </button>
        <p class="help-faq-answer hidden text-[13px] leading-relaxed text-[#444] mt-3">Domestic orders dispatch within 1–2 business days and arrive in 2–4 days. International express shipping takes 5–9 business days with full tracking.</p>
      </div>

      <div class="help-faq-item border-y border-black/10 py-4 reveal-on-scroll" data-topic="Shipping" data-delay="100">
        <button type="button" class="help-faq-toggle w-full flex justify-between items-center gap-3 text-left text-sm font-semibold cursor-pointer">
          <span>Do you offer Cash on Delivery (COD)?</span><span>▾</span>
        </button>
        <p class="help-faq-answer hidden text-[13px] leading-relaxed text-[#444] mt-3">Yes, Cash on Delivery is available for eligible metro areas at checkout with zero extra handling fees.</p>
      </div>

      <div class="help-faq-item border-y border-black/10 py-4 reveal-on-scroll" data-topic="Sizing" data-delay="150">
        <button type="button" class="help-faq-toggle w-full flex justify-between items-center gap-3 text-left text-sm font-semibold cursor-pointer">
          <span>How do your heavyweight tees and hoodies fit?</span><span>▾</span>
        </button>
        <p class="help-faq-answer hidden text-[13px] leading-relaxed text-[#444] mt-3">Our tees and hoodies feature a boxy, slightly cropped street fit with dropped shoulders. Take your true size for a relaxed drape or size down for a closer fit.</p>
      </div>

      <div class="help-faq-item border-y border-black/10 py-4 reveal-on-scroll" data-topic="Returns" data-delay="200">
        <button type="button" class="help-faq-toggle w-full flex justify-between items-center gap-3 text-left text-sm font-semibold cursor-pointer">
          <span>What is your return and size exchange policy?</span><span>▾</span>
        </button>
        <p class="help-faq-answer hidden text-[13px] leading-relaxed text-[#444] mt-3">Unworn items with original tags may be returned or exchanged within 14 days of delivery. Heritage and limited drops are eligible for store credit or size swap while stock lasts.</p>
      </div>

      <div class="help-faq-item border-y border-black/10 py-4 reveal-on-scroll" data-topic="Orders" data-delay="250">
        <button type="button" class="help-faq-toggle w-full flex justify-between items-center gap-3 text-left text-sm font-semibold cursor-pointer">
          <span>When will sold-out pieces be restocked?</span><span>▾</span>
        </button>
        <p class="help-faq-answer hidden text-[13px] leading-relaxed text-[#444] mt-3">Core heavyweight tees and caps restock monthly. Numbered Heritage pieces are single-run only. Subscribe to the newsletter for early drop access.</p>
      </div>
    </div>

    <section class="border border-black p-7 reveal-on-scroll">
      <div class="flex gap-2.5 mb-5">
        <button type="button" data-ticket-tab="order" class="ticket-tab font-display rounded-[30px] border border-black bg-black text-white px-4 py-2 text-[11px] cursor-pointer">ORDER SUPPORT</button>
        <button type="button" data-ticket-tab="sizing" class="ticket-tab font-display rounded-[30px] border border-black bg-white text-black px-4 py-2 text-[11px] cursor-pointer">SIZING &amp; RESTOCKS</button>
      </div>

      {% form 'contact', class: 'grid gap-3.5 max-w-[540px]' %}
        {%- if form.posted_successfully? -%}
          <div class="font-mono-meta text-[13px] py-4">
            ✓ Request submitted. Our customer care team will reply within 24 hours.
          </div>
        {%- else -%}
          {%- if form.errors -%}
            <div class="font-mono-meta text-xs text-red-700 border border-red-700 bg-red-50 p-3">
              {{ form.errors | default_errors }}
            </div>
          {%- endif -%}
          <input type="hidden" id="ticket-topic-input" name="contact[Topic]" value="Order Support" />
          <input type="email" name="contact[email]" required placeholder="Your email" class="h-11 rounded-[8px] border border-black px-3.5 text-[13px] outline-none" />
          <input id="ticket-order-input" type="text" name="contact[Order Number]" placeholder="Order number (e.g. #1001)" class="h-11 rounded-[8px] border border-black px-3.5 text-[13px] outline-none" />
          <textarea name="contact[body]" required rows="4" placeholder="Tell us how we can help..." class="rounded-[8px] border border-black p-3.5 text-[13px] outline-none"></textarea>
          <button type="submit" class="btn-sheen font-display justify-self-start bg-black text-white rounded-[30px] px-7 py-3 text-xs cursor-pointer">SUBMIT REQUEST</button>
        {%- endif -%}
      {% endform %}
    </section>
  </div>
</main>

{% schema %}
{
  "name": "KOTB Help Center",
  "settings": []
}
{% endschema %}
