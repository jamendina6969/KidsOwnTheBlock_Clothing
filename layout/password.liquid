<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>VIP EARLY ACCESS | {{ shop.name }}</title>
  <meta name="theme-color" content="#000000" />
  <link rel="icon" type="image/svg+xml" href="{{ 'favicon.svg' | asset_url }}" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@100..125,400..900&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  {{ 'kotb.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body class="min-h-screen bg-black text-white">
  <main class="min-h-screen bg-black text-white flex flex-col items-center justify-center px-4 text-center">
    <div class="anim-float mb-8">
      {% render 'brand-mark', color: 'white', size: 110, show_wordmark: false %}
    </div>

    <div class="font-mono-meta text-[11px] text-[#d9ff00] tracking-[0.2em] mb-2">DROP 05 · VIP EARLY ACCESS</div>
    <h1 class="font-display text-2xl md:text-3xl mb-6">ENTER STOREFRONT PASSCODE</h1>

    {% form 'storefront_password', class: 'w-full max-w-[340px] flex flex-col gap-3' %}
      {%- if form.errors -%}
        <div class="font-mono-meta text-xs text-red-400 border border-red-500 px-4 py-2 mb-2">
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}
      <input type="password" name="password" required placeholder="ENTER PASSCODE" class="h-12 rounded-[8px] border border-white/40 bg-black text-white text-center font-mono-meta tracking-[0.25em] uppercase text-sm outline-none focus:border-white" />
      <button type="submit" class="btn-sheen font-display bg-white text-black rounded-[30px] h-11 text-xs cursor-pointer">
        UNLOCK DROP
      </button>
    {% endform %}

    <div class="mt-8 w-full max-w-[340px]">
      {{ content_for_layout }}
    </div>
  </main>
</body>
</html>
