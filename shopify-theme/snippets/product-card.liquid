{%- assign card_surface = surface | default: 'white' -%}
{%- assign card_delay = delay | default: 0 -%}
{%- assign bg_class = 'bg-white' -%}
{%- if card_surface == 'grey' -%}{%- assign bg_class = 'bg-[#ededed]' -%}{%- endif -%}

<a
  href="{{ product.url }}"
  data-nav
  data-delay="{{ card_delay }}"
  aria-label="{{ product.title | escape }} — {{ product.price | money }}{% unless product.available %} (Sold out){% endunless %}"
  class="product-card reveal-on-scroll relative block w-full aspect-[4/5] overflow-hidden {{ bg_class }}"
>
  {%- unless product.available -%}
    <span class="anim-badge-glow absolute top-2.5 left-2.5 z-10 bg-white text-black border border-black rounded-[4rem] px-3 py-1 text-[11px] font-medium leading-tight">
      Sold out
    </span>
  {%- endunless -%}

  <div class="product-card-media">
    <div class="w-full h-full">
      {%- if product.featured_image != blank -%}
        <img
          src="{{ product.featured_image | image_url: width: 900 }}"
          alt="{{ product.featured_image.alt | default: product.title | escape }}"
          class="w-full h-full object-contain block"
          loading="lazy"
        />
      {%- else -%}
        {% render 'garment-svg', product: product, view: 'front' %}
      {%- endif -%}
    </div>

    {%- if product.images.size > 1 -%}
      <div class="view-back w-full h-full {{ bg_class }}">
        <img
          src="{{ product.images[1] | image_url: width: 900 }}"
          alt="{{ product.title | escape }} back view"
          class="w-full h-full object-contain block"
          loading="lazy"
        />
      </div>
    {%- elsif product.featured_image == blank -%}
      <div class="view-back w-full h-full {{ bg_class }}">
        {% render 'garment-svg', product: product, view: 'back' %}
      </div>
    {%- endif -%}
  </div>
</a>
