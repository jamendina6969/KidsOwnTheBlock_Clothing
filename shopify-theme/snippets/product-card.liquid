{%- assign card_surface = surface | default: 'white' -%}
{%- assign card_delay = delay | default: 0 -%}
{%- assign bg_class = 'bg-white' -%}
{%- if card_surface == 'grey' -%}{%- assign bg_class = 'bg-[#ededed]' -%}{%- endif -%}

{%- capture card_images_json -%}[{%- for img in product.images limit: 10 -%}{{ img | image_url: width: 900 | json }}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]{%- endcapture -%}

<div class="hood-card-outer reveal-on-scroll" data-delay="{{ card_delay }}">
  <div
    class="hood-card-media-box product-card {{ bg_class }}"
    {% if product.images.size > 1 %}data-card-images='{{ card_images_json }}'{% endif %}
  >
    {%- unless product.available -%}
      <span class="anim-badge-glow absolute top-2.5 left-2.5 z-20 bg-white text-black border border-black rounded-[4rem] px-3 py-1 text-[11px] font-medium leading-tight">
        Sold out
      </span>
    {%- endunless -%}

    {%- if product.images.size > 1 -%}
      <div class="hood-card-bars" aria-hidden="true">
        {%- for img in product.images limit: 10 -%}
          <span class="hood-card-bar{% if forloop.first %} is-active{% endif %}" data-card-bar-idx="{{ forloop.index0 }}"></span>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="hood-card-sheen" aria-hidden="true"></div>

    <a
      href="{{ product.url }}"
      data-nav
      aria-label="{{ product.title | escape }} — {{ product.price | money }}{% unless product.available %} (Sold out){% endunless %}"
      class="block w-full h-full"
    >
      <div class="product-card-media">
        <div class="w-full h-full">
          {%- if product.featured_image != blank -%}
            <img
              src="{{ product.featured_image | image_url: width: 900 }}"
              alt="{{ product.featured_image.alt | default: product.title | escape }}"
              class="hood-card-primary-img w-full h-full object-contain block"
              loading="lazy"
            />
          {%- else -%}
            {% render 'garment-svg', product: product, view: 'front' %}
          {%- endif -%}
        </div>

        {%- if product.images.size > 1 -%}
          <div class="hood-card-showcase-layer w-full h-full {{ bg_class }}">
            <img
              src="{{ product.images[1] | image_url: width: 900 }}"
              alt="{{ product.title | escape }} showcase view"
              class="hood-card-showcase-img w-full h-full object-contain block"
              loading="lazy"
            />
          </div>
        {%- elsif product.featured_image == blank -%}
          <div class="view-back w-full h-full {{ bg_class }}">
            {% render 'garment-svg', product: product, view: 'back' %}
          </div>
        {%- endif -%}
      </div>
    </a>

    {%- if product.available -%}
      <div class="hood-quick-add">
        <div class="hood-quick-add-label">QUICK ADD</div>
        <div class="hood-quick-sizes">
          {%- if product.has_only_default_variant -%}
            <button
              type="button"
              data-quick-add-id="{{ product.first_available_variant.id }}"
              class="hood-quick-size-btn"
              style="padding: 0 12px;"
            >
              + ADD TO CART
            </button>
          {%- else -%}
            {%- assign seen_sizes = ',' -%}
            {%- for variant in product.variants -%}
              {%- assign short_lbl = variant.title | split: '/' | last | strip -%}
              {%- assign size_token = ',' | append: short_lbl | append: ',' -%}
              {%- unless seen_sizes contains size_token -%}
                {%- assign seen_sizes = seen_sizes | append: short_lbl | append: ',' -%}
                <button
                  type="button"
                  data-quick-add-id="{{ variant.id }}"
                  {% unless variant.available %}disabled{% endunless %}
                  class="hood-quick-size-btn"
                  title="Add {{ product.title | escape }} — {{ variant.title | escape }}"
                >
                  {{ short_lbl }}
                </button>
              {%- endunless -%}
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>

  {%- assign card_title_down = product.title | downcase -%}
  {%- assign card_gsm = '' -%}
  {%- for tag in product.tags -%}
    {%- assign tag_down = tag | downcase -%}
    {%- if tag_down contains 'gsm' -%}
      {%- assign card_gsm = tag | upcase -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
  {%- if card_gsm == '' -%}
    {%- if card_title_down contains 'waffle' -%}
      {%- assign card_gsm = '350 GSM' -%}
    {%- elsif card_title_down contains 'hoodie' -%}
      {%- assign card_gsm = '340 GSM' -%}
    {%- elsif card_title_down contains 'tank' -%}
      {%- assign card_gsm = '280 GSM' -%}
    {%- elsif card_title_down contains 'tee' -%}
      {%- assign card_gsm = '260 GSM' -%}
    {%- endif -%}
  {%- endif -%}

  <a href="{{ product.url }}" data-nav class="hood-card-meta group">
    <div class="hood-card-title group-hover:underline">{{ product.title }}</div>
    <div class="hood-card-meta-row">
      <span class="hood-card-price">{{ product.price | money }}</span>
      {%- if card_gsm != '' -%}
        <span class="hood-card-gsm">{{ card_gsm }}</span>
      {%- endif -%}
    </div>
  </a>
</div>