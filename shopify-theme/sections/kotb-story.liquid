<main class="bg-white pt-10 pb-16">
  <div class="max-w-[1600px] mx-auto px-3 md:px-6">
    <div class="flex justify-between items-baseline flex-wrap gap-3 mb-7">
      <h1 class="font-display text-[28px]">BLOCK STORY</h1>
      <div class="flex gap-4">
        <a href="/pages/lookbooks" data-nav class="font-mono-meta text-[11px] underline">LOOKBOOKS ↗</a>
        <a href="/pages/run-club" data-nav class="font-mono-meta text-[11px] underline">RUN CLUB ↗</a>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-[1.4fr_0.6fr] gap-9 items-start">
      <div>
        <div class="border border-black mb-5 reveal-on-scroll">
          <div class="aspect-video bg-[#0a0a0a] relative flex items-center justify-center text-white overflow-hidden">
            <div class="absolute inset-0" style="background: linear-gradient(135deg, rgba(110,14,14,0.55) 0%, rgba(0,0,0,0.92) 75%);"></div>
            <button type="button" onclick="this.nextElementSibling.classList.remove('hidden'); this.classList.add('hidden')" class="relative z-10 w-16 h-16 rounded-full border border-white bg-black/65 flex items-center justify-center hover:scale-105 transition-transform cursor-pointer" aria-label="Play featured video">▶</button>
            <div class="hidden relative z-10 text-center p-6">
              <div class="font-display text-lg mb-2">NOW PLAYING: BLOCK PARTY 2026 — CAMPAIGN FILM</div>
              <p class="font-mono-meta text-xs text-[#aaa]">Shot on 16mm &amp; digital across downtown rooftops and late-night basketball courts.</p>
            </div>
            <span class="font-mono-meta absolute bottom-3.5 right-4 text-[11px] text-[#ccc]">02:48</span>
          </div>
          <div class="p-4">
            <div class="font-mono-meta text-[11px] text-[#666] mb-1.5">CAMPAIGN · NOV 2026</div>
            <h2 class="font-display text-lg mb-2">BLOCK PARTY 2026 — CAMPAIGN FILM</h2>
            <p class="text-[13px] text-[#333] leading-relaxed mb-3">Shot on 16mm &amp; digital across downtown rooftops and late-night basketball courts.</p>
            <span class="font-mono-meta text-[11px] font-semibold">WATCH ON YOUTUBE ↗</span>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="border border-black/15 reveal-on-scroll" data-delay="0">
            <div class="aspect-video bg-[#141414] flex items-center justify-center text-white relative">
              <button type="button" onclick="this.textContent='PLAYING · 04:12'; this.classList.remove('rounded-full','w-11','h-11','border')" class="w-11 h-11 rounded-full border border-white flex items-center justify-center text-xs hover:scale-105 transition-transform cursor-pointer">▶</button>
            </div>
            <div class="p-3.5">
              <div class="font-mono-meta text-[10px] text-[#666] mb-1">STUDIO BTS · OCT 2026</div>
              <h3 class="font-display text-[13px] mb-1.5 leading-snug">BEHIND THE PRINT: 240 GSM SILKSCREEN</h3>
              <p class="text-xs text-[#444] leading-relaxed mb-2.5">Inside our studio print room testing high-density plastisol inks for Drop 04.</p>
              <span class="font-mono-meta text-[10px] font-semibold">WATCH ON YOUTUBE ↗</span>
            </div>
          </div>

          <div class="border border-black/15 reveal-on-scroll" data-delay="80">
            <div class="aspect-video bg-[#141414] flex items-center justify-center text-white relative">
              <button type="button" onclick="this.textContent='PLAYING · 01:55'; this.classList.remove('rounded-full','w-11','h-11','border')" class="w-11 h-11 rounded-full border border-white flex items-center justify-center text-xs hover:scale-105 transition-transform cursor-pointer">▶</button>
            </div>
            <div class="p-3.5">
              <div class="font-mono-meta text-[10px] text-[#666] mb-1">COMMUNITY · OCT 2026</div>
              <h3 class="font-display text-[13px] mb-1.5 leading-snug">KOTB RUN CLUB: NIGHT 5K SESSION</h3>
              <p class="text-xs text-[#444] leading-relaxed mb-2.5">140 runners, one loop through the city core. Post-run espresso &amp; tees.</p>
              <span class="font-mono-meta text-[10px] font-semibold">WATCH ON YOUTUBE ↗</span>
            </div>
          </div>

          <div class="border border-black/15 reveal-on-scroll" data-delay="160">
            <div class="aspect-video bg-[#141414] flex items-center justify-center text-white relative">
              <button type="button" onclick="this.textContent='PLAYING · 03:20'; this.classList.remove('rounded-full','w-11','h-11','border')" class="w-11 h-11 rounded-full border border-white flex items-center justify-center text-xs hover:scale-105 transition-transform cursor-pointer">▶</button>
            </div>
            <div class="p-3.5">
              <div class="font-mono-meta text-[10px] text-[#666] mb-1">ARCHIVE · SEP 2026</div>
              <h3 class="font-display text-[13px] mb-1.5 leading-snug">DESIGNING THE NIGHT SHIFT JACKET</h3>
              <p class="text-xs text-[#444] leading-relaxed mb-2.5">Pattern drafting, enzyme washes, and chain-stitch embroidery breakdown.</p>
              <span class="font-mono-meta text-[10px] font-semibold">WATCH ON YOUTUBE ↗</span>
            </div>
          </div>
        </div>
      </div>

      <aside class="lg:border-l lg:border-black/10 lg:pl-6">
        <div class="flex justify-between items-center mb-4">
          <h2 class="font-display text-sm">LATEST POSTS</h2>
          <a href="/pages/lookbooks" data-nav class="font-mono-meta text-[10px]">VIEW ALL POSTS ↗</a>
        </div>
        <div class="flex flex-col gap-4">
          <div class="border border-black/15 p-3 reveal-on-scroll" data-delay="0">
            <div class="aspect-square text-white flex flex-col justify-between p-3.5 mb-2.5" style="background:#161616">
              <span class="font-mono-meta text-[10px] opacity-75">@kidsowntheblock</span>
              <span class="font-display text-lg">DROP 04</span>
            </div>
            <p class="text-xs leading-relaxed">Drop 04 Heavyweight 240 GSM Tees live now online &amp; flagship.</p>
          </div>
          <div class="border border-black/15 p-3 reveal-on-scroll" data-delay="90">
            <div class="aspect-square text-white flex flex-col justify-between p-3.5 mb-2.5" style="background:#5a0c0c">
              <span class="font-mono-meta text-[10px] opacity-75">@kotb.runclub</span>
              <span class="font-display text-lg">RUN CLUB</span>
            </div>
            <p class="text-xs leading-relaxed">Thursday 7:30 PM Downtown 5.2K loop. All paces welcome.</p>
          </div>
          <div class="border border-black/15 p-3 reveal-on-scroll" data-delay="180">
            <div class="aspect-square text-white flex flex-col justify-between p-3.5 mb-2.5" style="background:#162742">
              <span class="font-mono-meta text-[10px] opacity-75">@kidsowntheblock</span>
              <span class="font-display text-lg">LOOKBOOK</span>
            </div>
            <p class="text-xs leading-relaxed">Midnight Block Lookbook shot in studio. 5 new silhouettes.</p>
          </div>
        </div>
      </aside>
    </div>
  </div>
</main>

{% schema %}
{
  "name": "KOTB Block Story",
  "settings": []
}
{% endschema %}
