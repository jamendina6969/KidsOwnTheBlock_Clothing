{%- comment -%} HOOD Story Editorial Section with Full Customizer Controls {%- endcomment -%}
{%- assign anim_style = section.settings.animation_style | default: 'flash-35mm' -%}

<main class="bg-white pt-10 pb-16 hood-story-section" data-animation-style="{{ anim_style }}">
  <div class="max-w-[1600px] mx-auto px-3 md:px-6">
    <div class="flex justify-between items-baseline flex-wrap gap-3 mb-7">
      <h1 class="font-display text-[28px] tracking-[0.04em]">{{ section.settings.heading | default: 'HOOD STORY' }}</h1>
      <div class="flex gap-4">
        {%- if section.settings.sublink_1_label != blank -%}
          <a href="{{ section.settings.sublink_1_url | default: routes.all_products_collection_url }}" data-nav class="font-mono-meta text-[11px] underline">{{ section.settings.sublink_1_label }}</a>
        {%- endif -%}
        {%- if section.settings.sublink_2_label != blank -%}
          <a href="{{ section.settings.sublink_2_url | default: '/collections/no-evil' }}" data-nav class="font-mono-meta text-[11px] underline">{{ section.settings.sublink_2_label }}</a>
        {%- endif -%}
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-[1.4fr_0.6fr] gap-9 items-start">
      <div>
        {%- comment -%} Featured Campaign Hero Photo {%- endcomment -%}
        <a href="{{ section.settings.hero_link | default: '/collections/no-evil' }}" data-nav class="story-hero-card block border border-black mb-5 reveal-on-scroll group overflow-hidden relative">
          <div class="aspect-[4/5] sm:aspect-[16/11] bg-[#0a0a0a] relative overflow-hidden">
            {%- if section.settings.hero_image != blank -%}
              <img src="{{ section.settings.hero_image | image_url: width: 1600 }}" alt="{{ section.settings.hero_title | escape }}" class="w-full h-full object-cover object-top group-hover:scale-[1.03] transition-transform duration-700 ease-out story-img" />
            {%- else -%}
              <img src="{{ 'campaign-duo-tees.jpg' | asset_url }}" alt="HOODLUMS NO EVIL Campaign" class="w-full h-full object-cover object-top group-hover:scale-[1.03] transition-transform duration-700 ease-out story-img" />
            {%- endif -%}
            <div class="story-flash-overlay pointer-events-none absolute inset-0 bg-white opacity-0 transition-opacity duration-300"></div>
          </div>
          <div class="p-4 bg-white relative z-10">
            <div class="font-mono-meta text-[11px] text-[#666] mb-1.5">{{ section.settings.hero_tag | default: 'CAMPAIGN · NO EVIL DROP' }}</div>
            <h2 class="font-display text-lg mb-2">{{ section.settings.hero_title | default: 'HOODLUMS — NO EVIL 400 GSM CAMPAIGN' }}</h2>
            <p class="text-[13px] text-[#333] leading-relaxed mb-3">{{ section.settings.hero_desc | default: 'See nothing. Hear nothing. Say nothing. Shot on 35mm direct flash featuring our heavyweight boxy & snow-washed tees.' }}</p>
            <span class="font-mono-meta text-[11px] font-semibold underline">{{ section.settings.hero_cta | default: 'SHOP THE DROP ↗' }}</span>
          </div>
        </a>

        {%- comment -%} Editorial Grid Photos {%- endcomment -%}
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <a href="{{ section.settings.card1_link | default: '/collections/no-evil' }}" data-nav class="story-card block border border-black/15 hover:border-black transition-colors reveal-on-scroll group overflow-hidden" data-delay="0">
            <div class="aspect-[3/4] bg-[#141414] overflow-hidden relative">
              {%- if section.settings.card1_image != blank -%}
                <img src="{{ section.settings.card1_image | image_url: width: 1000 }}" alt="{{ section.settings.card1_title | escape }}" class="w-full h-full object-cover object-top group-hover:scale-[1.04] transition-transform duration-500 story-img" />
              {%- else -%}
                <img src="{{ 'campaign-female.jpg' | asset_url }}" alt="NO EVIL Boxy Oversized Tee" class="w-full h-full object-cover object-top group-hover:scale-[1.04] transition-transform duration-500 story-img" />
              {%- endif -%}
              <div class="story-flash-overlay pointer-events-none absolute inset-0 bg-white opacity-0 transition-opacity duration-200"></div>
            </div>
            <div class="p-3.5 bg-white">
              <div class="font-mono-meta text-[10px] text-[#666] mb-1">{{ section.settings.card1_tag | default: 'EDITORIAL · 400 GSM' }}</div>
              <h3 class="font-display text-[13px] mb-1.5 leading-snug">{{ section.settings.card1_title | default: 'BOXY OVERSIZED TEE — CONCRETE FLASH' }}</h3>
              <p class="text-xs text-[#444] leading-relaxed">{{ section.settings.card1_desc | default: 'Structured H-line drop shoulder fit with distressed sand-grain front print.' }}</p>
            </div>
          </a>

          <a href="{{ section.settings.card2_link | default: '/collections/no-evil' }}" data-nav class="story-card block border border-black/15 hover:border-black transition-colors reveal-on-scroll group overflow-hidden" data-delay="80">
            <div class="aspect-[3/4] bg-[#141414] overflow-hidden relative">
              {%- if section.settings.card2_image != blank -%}
                <img src="{{ section.settings.card2_image | image_url: width: 1000 }}" alt="{{ section.settings.card2_title | escape }}" class="w-full h-full object-cover object-top group-hover:scale-[1.04] transition-transform duration-500 story-img" />
              {%- else -%}
                <img src="{{ 'campaign-male.jpg' | asset_url }}" alt="NO EVIL Industrial Lookbook" class="w-full h-full object-cover object-top group-hover:scale-[1.04] transition-transform duration-500 story-img" />
              {%- endif -%}
              <div class="story-flash-overlay pointer-events-none absolute inset-0 bg-white opacity-0 transition-opacity duration-200"></div>
            </div>
            <div class="p-3.5 bg-white">
              <div class="font-mono-meta text-[10px] text-[#666] mb-1">{{ section.settings.card2_tag | default: 'LOOKBOOK · DROP 01' }}</div>
              <h3 class="font-display text-[13px] mb-1.5 leading-snug">{{ section.settings.card2_title | default: 'INDUSTRIAL STAIRWELL // HEAVYWEIGHT' }}</h3>
              <p class="text-xs text-[#444] leading-relaxed">{{ section.settings.card2_desc | default: 'Built to hold its shape from the hood to late nights out.' }}</p>
            </div>
          </a>
        </div>
      </div>

      {%- comment -%} Right Sidebar: Featured Capsule Look {%- endcomment -%}
      <aside class="lg:border-l lg:border-black/10 lg:pl-6">
        <div class="flex justify-between items-center mb-4">
          <h2 class="font-display text-sm">{{ section.settings.side_heading | default: 'FEATURED CAPSULE' }}</h2>
          <a href="{{ section.settings.side_view_link | default: '/collections/no-evil' }}" data-nav class="font-mono-meta text-[10px] underline">{{ section.settings.side_view_label | default: 'VIEW COLLECTION ↗' }}</a>
        </div>
        <div class="flex flex-col gap-4">
          <a href="{{ section.settings.side_link | default: '/collections/no-evil' }}" data-nav class="story-card block border border-black/15 hover:border-black transition-colors p-3 reveal-on-scroll group" data-delay="0">
            <div class="aspect-[3/4] bg-[#161616] overflow-hidden mb-3 relative">
              {%- if section.settings.side_image != blank -%}
                <img src="{{ section.settings.side_image | image_url: width: 1000 }}" alt="{{ section.settings.side_title | escape }}" class="w-full h-full object-cover object-top group-hover:scale-[1.04] transition-transform duration-500 story-img" />
              {%- else -%}
                <img src="{{ 'campaign-duo-tank.jpg' | asset_url }}" alt="NO EVIL Tank & Washed Tee" class="w-full h-full object-cover object-top group-hover:scale-[1.04] transition-transform duration-500 story-img" />
              {%- endif -%}
              <div class="story-flash-overlay pointer-events-none absolute inset-0 bg-white opacity-0 transition-opacity duration-200"></div>
            </div>
            <div class="font-display text-sm mb-1">{{ section.settings.side_title | default: 'NO EVIL // TANK & WASHED TEE' }}</div>
            <p class="text-xs text-[#444] leading-relaxed">{{ section.settings.side_desc | default: 'Now live worldwide in S–2XL. Direct DTF print on 100% heavyweight cotton.' }}</p>
          </a>
        </div>
      </aside>
    </div>
  </div>
</main>

{% schema %}
{
  "name": "HOOD Story",
  "settings": [
    { "type": "header", "content": "Page Header & Animation" },
    { "type": "text", "id": "heading", "label": "Page Heading", "default": "HOOD STORY" },
    {
      "type": "select",
      "id": "animation_style",
      "label": "Animation & Transition Style",
      "options": [
        { "value": "flash-35mm", "label": "35mm Direct Flash & Vignette" },
        { "value": "shutter-blink", "label": "Brutalist Mechanical Shutter" },
        { "value": "lens-push", "label": "Editorial Lens Push & Parallax" }
      ],
      "default": "flash-35mm"
    },
    { "type": "text", "id": "sublink_1_label", "label": "Top Sublink 1 Label", "default": "SHOP ALL ↗" },
    { "type": "url", "id": "sublink_1_url", "label": "Top Sublink 1 URL" },
    { "type": "text", "id": "sublink_2_label", "label": "Top Sublink 2 Label", "default": "NO EVIL CAPSULE ↗" },
    { "type": "url", "id": "sublink_2_url", "label": "Top Sublink 2 URL" },
    { "type": "header", "content": "Featured Hero Campaign" },
    { "type": "image_picker", "id": "hero_image", "label": "Hero Image (Optional override)" },
    { "type": "text", "id": "hero_tag", "label": "Hero Eyebrow", "default": "CAMPAIGN · NO EVIL DROP" },
    { "type": "text", "id": "hero_title", "label": "Hero Title", "default": "HOODLUMS — NO EVIL 400 GSM CAMPAIGN" },
    { "type": "textarea", "id": "hero_desc", "label": "Hero Description", "default": "See nothing. Hear nothing. Say nothing. Shot on 35mm direct flash featuring our heavyweight boxy & snow-washed tees." },
    { "type": "text", "id": "hero_cta", "label": "Hero CTA Button Label", "default": "SHOP THE DROP ↗" },
    { "type": "url", "id": "hero_link", "label": "Hero Destination Link" },
    { "type": "header", "content": "Editorial Card 1" },
    { "type": "image_picker", "id": "card1_image", "label": "Card 1 Image (Optional override)" },
    { "type": "text", "id": "card1_tag", "label": "Card 1 Eyebrow", "default": "EDITORIAL · 400 GSM" },
    { "type": "text", "id": "card1_title", "label": "Card 1 Title", "default": "BOXY OVERSIZED TEE — CONCRETE FLASH" },
    { "type": "textarea", "id": "card1_desc", "label": "Card 1 Description", "default": "Structured H-line drop shoulder fit with distressed sand-grain front print." },
    { "type": "url", "id": "card1_link", "label": "Card 1 Link" },
    { "type": "header", "content": "Editorial Card 2" },
    { "type": "image_picker", "id": "card2_image", "label": "Card 2 Image (Optional override)" },
    { "type": "text", "id": "card2_tag", "label": "Card 2 Eyebrow", "default": "LOOKBOOK · DROP 01" },
    { "type": "text", "id": "card2_title", "label": "Card 2 Title", "default": "INDUSTRIAL STAIRWELL // HEAVYWEIGHT" },
    { "type": "textarea", "id": "card2_desc", "label": "Card 2 Description", "default": "Built to hold its shape from the hood to late nights out." },
    { "type": "url", "id": "card2_link", "label": "Card 2 Link" },
    { "type": "header", "content": "Sidebar Featured Capsule" },
    { "type": "text", "id": "side_heading", "label": "Sidebar Heading", "default": "FEATURED CAPSULE" },
    { "type": "text", "id": "side_view_label", "label": "Sidebar Link Label", "default": "VIEW COLLECTION ↗" },
    { "type": "url", "id": "side_view_link", "label": "Sidebar Link URL" },
    { "type": "image_picker", "id": "side_image", "label": "Sidebar Image (Optional override)" },
    { "type": "text", "id": "side_title", "label": "Sidebar Title", "default": "NO EVIL // TANK & WASHED TEE" },
    { "type": "textarea", "id": "side_desc", "label": "Sidebar Description", "default": "Now live worldwide in S–2XL. Direct DTF print on 100% heavyweight cotton." },
    { "type": "url", "id": "side_link", "label": "Sidebar Link" }
  ]
}
{% endschema %}