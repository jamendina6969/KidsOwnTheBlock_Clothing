{%- assign current_variant = product.selected_or_first_available_variant -%}

<main class="bg-white pt-8 pb-20">
  <div class="max-w-[1600px] mx-auto px-3 md:px-6">
    <nav aria-label="Breadcrumb" class="font-mono-meta text-[11px] text-[#666] mb-6 flex items-center gap-2">
      <a href="{{ routes.all_products_collection_url }}" data-nav class="hover:text-black">SHOP</a>
      <span>/</span>
      <span class="text-black">{{ product.title | upcase }}</span>
    </nav>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
      {%- comment -%} Left: Product Media Gallery {%- endcomment -%}
      <div class="lg:col-span-7 flex flex-col gap-3">
        <div id="pdp-main-stage" class="pdp-zoom-container bg-white border border-black/10 aspect-square w-full flex items-center justify-center overflow-hidden">
          {%- if product.featured_image != blank -%}
            <img
              id="pdp-main-img"
              src="{{ product.featured_image | image_url: width: 1200 }}"
              alt="{{ product.featured_image.alt | default: product.title | escape }}"
              class="w-full h-full object-contain block"
            />
          {%- else -%}
            {% render 'garment-svg', product: product, view: 'front' %}
          {%- endif -%}
        </div>

        {%- if product.images.size > 1 -%}
          <div class="grid grid-cols-4 sm:grid-cols-6 gap-2">
            {%- for image in product.images -%}
              <button
                type="button"
                data-pdp-thumb="{{ image | image_url: width: 1200 }}"
                class="aspect-square bg-white border {% if forloop.first %}border-black{% else %}border-black/10 hover:border-black/40{% endif %} overflow-hidden cursor-pointer transition-colors"
              >
                <img
                  src="{{ image | image_url: width: 300 }}"
                  alt="{{ image.alt | default: product.title | escape }}"
                  class="w-full h-full object-contain block"
                  loading="lazy"
                />
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} Right: Product Info & Add to Cart {%- endcomment -%}
      <div class="lg:col-span-5 lg:sticky lg:top-24 flex flex-col gap-5">
        <div class="border-b border-black/10 pb-5">
          {%- if product.type != blank -%}
            <div class="font-mono-meta text-[11px] text-[#666] uppercase mb-1.5">{{ product.type }}</div>
          {%- endif -%}
          <h1 class="font-display text-2xl md:text-3xl leading-tight">{{ product.title }}</h1>
          <div class="mt-2.5 flex items-center gap-3">
            <span id="pdp-price" class="font-mono-meta text-lg font-semibold">{{ current_variant.price | money }}</span>
            {%- if current_variant.compare_at_price > current_variant.price -%}
              <span class="font-mono-meta text-sm text-[#666] line-through">{{ current_variant.compare_at_price | money }}</span>
            {%- endif -%}
            {%- unless product.available -%}
              <span class="font-mono-meta text-[11px] border border-black px-2.5 py-0.5 rounded-full">SOLD OUT</span>
            {%- endunless -%}
          </div>
        </div>

        <div class="hood-scarcity-meter my-4">
          <div class="flex items-center justify-between font-mono-meta text-[11px]">
            <span class="flex items-center gap-1.5 font-semibold text-black">
              <span class="w-2 h-2 rounded-full bg-[#d9ff00] border border-black inline-block"></span>
              BATCH 01 // DROP ALLOCATION
            </span>
            <span class="text-[#666]">84% CLAIMED</span>
          </div>
          <div class="hood-scarcity-bar">
            <div class="hood-scarcity-fill" style="width: 84%;"></div>
          </div>
        </div>

        <div class="bg-[#f6f6f6] border border-black/15 p-3 font-mono-meta text-[11px] text-[#444] mb-1">
          <div class="font-bold text-black mb-1">ON-BODY FIT REFERENCE:</div>
          <div>· Male: 5'11" (180cm) / 70kg wearing <strong>Size L</strong> (Boxy Fit)</div>
          <div>· Female: 5'5" (165cm) / 48kg wearing <strong>Size M</strong> (Relaxed Street Fit)</div>
        </div>

        {% form 'product', product, id: 'pdp-add-to-cart-form', class: 'flex flex-col gap-5' %}
          <input type="hidden" name="id" id="pdp-variant-id" value="{{ current_variant.id }}" />

          {%- unless product.has_only_default_variant -%}
            <div>
              <div class="font-mono-meta text-[11px] text-[#666] mb-2">SELECT VARIANT</div>
              <div class="flex flex-wrap gap-2">
                {%- for variant in product.variants -%}
                  <button
                    type="button"
                    data-variant-btn
                    data-variant-id="{{ variant.id }}"
                    data-variant-price="{{ variant.price | money }}"
                    data-variant-available="{{ variant.available }}"
                    {% unless variant.available %}disabled{% endunless %}
                    class="size-pill font-mono-meta text-xs min-w-[48px] px-3.5 h-10 border transition-colors {% if variant.id == current_variant.id %}bg-black text-white border-black{% elsif variant.available %}bg-white text-black border-black/30 hover:border-black cursor-pointer{% else %}bg-[#f5f5f5] text-[#999] border-black/10 line-through cursor-not-allowed{% endif %}"
                  >
                    {{ variant.title }}
                  </button>
                {%- endfor -%}
              </div>
            </div>
          {%- endunless -%}

          <div class="flex items-center gap-3">
            <div class="inline-flex items-center border border-black rounded-[8px] h-12">
              <button type="button" data-pdp-qty="-1" aria-label="Decrease quantity" class="w-10 h-full flex items-center justify-center text-sm cursor-pointer">-</button>
              <input id="pdp-qty-input" type="number" name="quantity" value="1" min="1" class="font-mono-meta w-10 text-center text-xs bg-transparent outline-none" />
              <button type="button" data-pdp-qty="1" aria-label="Increase quantity" class="w-10 h-full flex items-center justify-center text-sm cursor-pointer">+</button>
            </div>

            <button
              id="pdp-submit-btn"
              type="submit"
              {% unless current_variant.available %}disabled{% endunless %}
              class="btn-sheen font-display flex-1 h-12 rounded-[30px] text-xs tracking-[0.08em] transition-opacity {% if current_variant.available %}bg-black text-white cursor-pointer hover:opacity-85{% else %}bg-[#ccc] text-[#666] cursor-not-allowed{% endif %}"
            >
              {%- if current_variant.available -%}ADD TO CART{%- else -%}SOLD OUT{%- endif -%}
            </button>
          </div>

          {%- comment -%} Global Streetwear Fulfillment & Trust Badges {%- endcomment -%}
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 p-3 bg-[#f9f9f9] border border-black/10">
            <div class="flex items-center gap-1.5 font-mono-meta text-[10px] text-[#222]">
              <span class="text-black font-bold">✓</span>
              <span>WORLDWIDE TRACKED SHIPPING</span>
            </div>
            <div class="flex items-center gap-1.5 font-mono-meta text-[10px] text-[#222]">
              <span class="text-black font-bold">✓</span>
              <span>HEAVYWEIGHT STREETWEAR CUT</span>
            </div>
            <div class="flex items-center gap-1.5 font-mono-meta text-[10px] text-[#222]">
              <span class="text-black font-bold">✓</span>
              <span>MADE TO ORDER · ZERO WASTE</span>
            </div>
            <div class="flex items-center gap-1.5 font-mono-meta text-[10px] text-[#222]">
              <span class="text-black font-bold">✓</span>
              <span>SECURE ENCRYPTED CHECKOUT</span>
            </div>
          </div>

          <div id="pdp-stock-error" class="hidden font-mono-meta text-xs text-red-600 border border-red-600 px-3 py-2"></div>
        {% endform %}

        {%- if product.description != blank -%}
          <div class="border-t border-black/10 pt-5 text-sm leading-relaxed text-[#222] space-y-3">
            {{ product.description }}
          </div>
        {%- endif -%}

        {%- assign pdp_title_down = product.title | downcase -%}
        {%- assign spec_weight = 'Heavyweight Cotton Blend' -%}
        {%- assign spec_collar = 'Heavyweight Ribbed Crewneck' -%}
        {%- if pdp_title_down contains 'waffle' -%}
          {%- assign spec_weight = '350 GSM (10.3 oz) Cotton-Blend Waffle Knit' -%}
          {%- assign spec_collar = 'Structured Double-Layer Hood' -%}
        {%- elsif pdp_title_down contains 'hoodie' -%}
          {%- assign spec_weight = '340 GSM (10.0 oz) Thick Fleece-Lined Knit' -%}
          {%- assign spec_collar = 'Structured Double-Layer Hood' -%}
        {%- elsif pdp_title_down contains 'tank' -%}
          {%- assign spec_weight = 'Heavyweight Combed Cotton Knit' -%}
          {%- assign spec_collar = 'Reinforced Ribbed Crewneck & Armholes' -%}
        {%- elsif pdp_title_down contains 'tee' -%}
          {%- assign spec_weight = 'Heavyweight Combed Ring-Spun Cotton' -%}
          {%- assign spec_collar = '1.25" Heavyweight Ribbed Crewneck' -%}
        {%- endif -%}

        <div class="border-t border-black/10 pt-5">
          <div class="font-mono-meta text-[11px] tracking-[0.14em] text-[#666] mb-3">TECHNICAL GARMENT SPEC SHEET</div>
          <table class="hood-spec-table text-xs">
            <tbody>
              <tr>
                <td class="text-[#666]">FABRIC WEIGHT</td>
                <td class="font-bold">{{ spec_weight }}</td>
              </tr>
              <tr>
                <td class="text-[#666]">SILHOUETTE</td>
                <td class="font-bold">Boxy Oversized // Dropped Shoulders</td>
              </tr>
              <tr>
                <td class="text-[#666]">PRINT TECHNIQUE</td>
                <td class="font-bold">High-Density Direct Garment Print</td>
              </tr>
              <tr>
                <td class="text-[#666]">NECKLINE</td>
                <td class="font-bold">{{ spec_collar }}</td>
              </tr>
              <tr>
                <td class="text-[#666]">FULFILLMENT</td>
                <td class="font-bold">Made to Order // Worldwide Tracked Dispatch</td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="border-t border-black/10 pt-5 font-mono-meta text-[11px] text-[#666] space-y-1.5">
          <div>{{ section.settings.spec_1 | default: '· HEAVYWEIGHT CUT & SEW STREETWEAR' }}</div>
          <div>{{ section.settings.spec_2 | default: '· WORLDWIDE TRACKED DISPATCH' }}</div>
          <div>{{ section.settings.spec_3 | default: '· CHECK SIZE CHART BEFORE ORDERING' }}</div>
        </div>
      </div>
    </div>
  </div>
</main>

{% schema %}
{
  "name": "HOOD Product Detail",
  "settings": [
    { "type": "text", "id": "spec_1", "label": "Spec Line 1", "default": "· HEAVYWEIGHT CUT & SEW STREETWEAR" },
    { "type": "text", "id": "spec_2", "label": "Spec Line 2", "default": "· WORLDWIDE TRACKED DISPATCH" },
    { "type": "text", "id": "spec_3", "label": "Spec Line 3", "default": "· CHECK SIZE CHART BEFORE ORDERING" }
  ]
}
{% endschema %}
