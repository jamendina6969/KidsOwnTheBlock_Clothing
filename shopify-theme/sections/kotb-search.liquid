{%- paginate search.results by 12 -%}
<main class="bg-white pt-10 pb-20">
  <div class="max-w-[1600px] mx-auto px-3 md:px-6">
    <div class="pb-6 mb-8 border-b border-black/10">
      <h1 class="font-display text-2xl md:text-3xl mb-4">SEARCH</h1>
      <form action="{{ routes.search_url }}" method="get" class="max-w-[520px] flex gap-2">
        <input type="hidden" name="type" value="product" />
        <input
          type="text"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder="Search tees, hoodies, cargo..."
          class="flex-1 h-11 rounded-[8px] border border-black px-4 text-sm outline-none"
        />
        <button type="submit" class="font-display bg-black text-white rounded-[30px] px-6 text-xs cursor-pointer">
          SEARCH
        </button>
      </form>
    </div>

    {%- if search.performed -%}
      <div class="font-mono-meta text-xs text-[#666] mb-5">
        {{ search.results_count }} {% if search.results_count == 1 %}RESULT{% else %}RESULTS{% endif %} FOR "{{ search.terms | escape | upcase }}"
      </div>

      {%- if search.results_count == 0 -%}
        <div class="py-16 text-center">
          <p class="font-display text-base mb-4">NO MATCHING GARMENTS FOUND</p>
          <a href="{{ routes.all_products_collection_url }}" data-nav class="font-display inline-block border border-black rounded-[30px] px-6 py-2.5 text-xs">VIEW ALL PRODUCTS</a>
        </div>
      {%- else -%}
        <div class="grid grid-cols-2 md:grid-cols-4 gap-1 md:gap-2">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {%- assign mod_idx = forloop.index0 | modulo: 4 -%}
              {%- assign card_delay = mod_idx | times: 60 -%}
              {% render 'product-card', product: item, surface: 'white', delay: card_delay %}
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if paginate.pages > 1 -%}
        <div class="font-mono-meta flex justify-center items-center gap-5 mt-12 text-[13px]">
          {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" data-nav>&lt;</a>{%- endif -%}
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}
              <a href="{{ part.url }}" data-nav class="pb-0.5 border-b border-transparent hover:border-black">{{ part.title }}</a>
            {%- else -%}
              <span class="pb-0.5 border-b border-black font-semibold">{{ part.title }}</span>
            {%- endif -%}
          {%- endfor -%}
          {%- if paginate.next -%}<a href="{{ paginate.next.url }}" data-nav>&gt;</a>{%- endif -%}
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</main>
{%- endpaginate -%}

{% schema %}
{
  "name": "KOTB Search Results",
  "settings": []
}
{% endschema %}
